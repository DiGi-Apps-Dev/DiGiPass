# Copia questo file in .env (permessi 600) e completalo. Il .env contiene segreti: non metterlo mai nel repository.

# Obbligatoria: 32 byte casuali. Si genera con:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Cifra il segreto dell'Authenticator e i backup. Persa questa chiave, i backup non si riaprono e l'Authenticator va
# riconfigurato (i dati della cassaforte restano leggibili dal telefono: sono cifrati con la password principale).
DIGIPASS_AUTH_KEY=

# 1 solo per la prima configurazione dall'app del telefono; poi 0 e ricrea il container (vedi README).
DIGIPASS_ALLOW_SETUP=1

# Codice monouso per la prima configurazione dal telefono, almeno 8 caratteri scelti da te.
DIGIPASS_CODICE_SETUP=

# Fuso orario.
TZ=Europe/Rome

# Nome del tuo proxy HTTPS nella rete Docker, se ne usi uno (vedi README).
PROXY_FIDATO=

# Email di sicurezza, facoltativa (accessi, codici di riserva usati, password cambiata, backup falliti).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SECURITY_EMAIL_TO=
